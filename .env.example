# Copy this file to .env and fill in real values. .env is gitignored.

# Local dev: postgresql://mlw:mlw@localhost:5432/mlw
# Production (self-hosted on the droplet): postgresql://mlw:STRONG_PASSWORD@localhost:5432/mlw
DATABASE_URL=postgresql://mlw:mlw@localhost:5432/mlw

# Filled in during Phase 3 (Paystack checkout)
PAYSTACK_SECRET_KEY=

# Filled in during Phase 4 (WhatsApp chatbot)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Filled in during Phase 2 (admin CMS auth)
ADMIN_SESSION_SECRET=

# Filled in when wiring DigitalOcean Spaces image uploads
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
